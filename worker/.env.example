# Zora presence worker — copy to .env on the Linux VM. Never commit real values.

# --- API mode (worker takes instructions from the Zora web app) ---
ZORA_API_BASE=https://rich-status-studio.lovable.app
WORKER_SHARED_SECRET=

# --- Standalone mode (worker runs on its own, no Zora app needed) ---
# Set to 1 to run standalone. The worker then reads presence.json and keeps
# its own Discord login in tokens.json (created once via `./zora-presence-worker link`).
ZORA_STANDALONE=0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a Redirect URI saved in the Discord Developer Portal (OAuth2 → Redirects).
DISCORD_REDIRECT_URI=https://127.0.0.1
# PRESENCE_FILE=presence.json
# TOKENS_FILE=tokens.json

DISCORD_APP_ID=
POLL_INTERVAL_MS=5000
